+            updateStmt.setString(2, email);
+            updateStmt.setString(3, password);
+            updateStmt.setInt(4, userId);
+
+            if (updateStmt.executeUpdate() <= 0) {
+                return null;
+            }
+
+            selectStmt.setInt(1, userId);
+
+            try (ResultSet rs = selectStmt.executeQuery()) {
+                if (!rs.next()) {
+                    return null;
