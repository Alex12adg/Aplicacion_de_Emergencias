+                        appointmentDatePicker.getValue(),
+                        startTimeField.getText(),
+                        endTimeField.getText(),
+                        purposeField.getText(),
+                        notesArea.getText()
+                );
+                loadData();
+                statusLabel.setText("Reserva registrada correctamente");
